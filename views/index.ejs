<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= appName %></title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="app">
      <main class="container">
        <header>
          <h1>🛡️ Courier Fraud Check</h1>
          <p class="subtitle">by WebCraft</p>
        </header>

        <form id="checkForm" autocomplete="off">
          <input
            id="phone"
            name="phone"
            type="tel"
            inputmode="numeric"
            pattern="01[3-9][0-9]{8}"
            placeholder="01XXXXXXXXX"
            required
          />
          <button type="submit" id="checkBtn">Check</button>
        </form>

        <div class="controls">
          <p class="hint">
            Enter an 11-digit Bangladeshi mobile number (e.g. 017XXXXXXXX),
            without +88.
          </p>
          <div class="couriers-status" id="couriersStatus"></div>
        </div>

        <section id="status" class="status hidden"></section>
        <section id="results" class="results hidden"></section>
      </main>

      <footer class="site-footer">
        <div class="footer-inner">
          <div class="footer-brand">
            Built by
            <a href="https://webcraft.com.bd" target="_blank" rel="noopener">
              WebCraft
            </a>
          </div>
          <div class="footer-copy">
            © <span id="year"></span> WebCraft. All rights reserved.
          </div>
        </div>
      </footer>
    </div>

    <script>
      // ── Element refs ──────────────────────────────────────────────────────
      const form = document.getElementById("checkForm");
      const phoneInput = document.getElementById("phone");
      const checkBtn = document.getElementById("checkBtn");
      const statusEl = document.getElementById("status");
      const resultsEl = document.getElementById("results");
      const couriersStatusEl = document.getElementById("couriersStatus");
      document.getElementById("year").textContent = new Date().getFullYear();

      // ── State ─────────────────────────────────────────────────────────────
      let AVAILABLE_COURIERS = [];
      let CURRENT_PHONE = "";
      let CURRENT_DATA = null;

      // ── Utilities ─────────────────────────────────────────────────────────
      function show(el, html) {
        el.classList.remove("hidden");
        el.innerHTML = html;
      }
      function hide(el) {
        el.classList.add("hidden");
        el.innerHTML = "";
      }
      function esc(v) {
        return String(v).replace(
          /[&<>"']/g,
          (c) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            })[c],
        );
      }
      function setLoading(on) {
        checkBtn.disabled = on;
        checkBtn.textContent = on ? "Checking…" : "Check";
      }

      // ── Shape detection ───────────────────────────────────────────────────
      function shapeOf(data) {
        if (!data) return "none";
        if (typeof data.error === "string") return "error";
        if (typeof data.delivery_ratio === "number") return "steadfast";
        if (
          data.data &&
          typeof data.data === "object" &&
          ("customer_rating" in data.data ||
            "show_count" in data.data ||
            data.data.version === "v2" ||
            data.data.data_type === "rating")
        ) {
          return "pathao";
        }
        if (
          typeof data.fraud_count === "number" ||
          typeof data.customer_name === "string" ||
          data.customer_id !== undefined
        ) {
          return "carrybee";
        }
        if (
          typeof data.success === "number" &&
          typeof data.total === "number"
        ) {
          return "classic";
        }
        return "unknown";
      }

      const PATHAO_RATING_MAP = {
        excellent_customer: { cls: "good", label: "Excellent" },
        good_customer: { cls: "good", label: "Good" },
        moderate_customer: { cls: "warn", label: "Moderate" },
        average_customer: { cls: "warn", label: "Average" },
        new_customer: { cls: "warn", label: "New" },
        risky_customer: { cls: "bad", label: "Risky" },
        bad_customer: { cls: "bad", label: "Bad" },
      };

      const PATHAO_RISK_MAP = {
        low: "good",
        medium: "warn",
        high: "bad",
        very_high: "bad",
        unknown: "",
      };

      // ── Card rendering ────────────────────────────────────────────────────
      function renderCourierCard(name, data) {
        const shape = shapeOf(data);
        const refreshBtn = `
          <button class="card-refresh" data-courier="${esc(name)}" title="Re-check this courier">
            ↻
          </button>`;

        if (shape === "none") {
          return `
          <div class="card error">
            <div class="card-header">
              <span class="name">${esc(name)}</span>
              <span class="badge error">No data</span>
            </div>
          </div>`;
        }

        if (shape === "error") {
          return `
          <div class="card error">
            <div class="card-header">
              <span class="name">${esc(name)}</span>
              <span class="badge error">Error</span>
              ${refreshBtn}
            </div>
            <p class="msg">${esc(data.message || data.error)}</p>
            ${data.status ? `<p class="status-code">HTTP ${esc(data.status)}</p>` : ""}
          </div>`;
        }

        if (shape === "steadfast") {
          const dr = Number(data.delivery_ratio || 0);
          const cr = Number(data.cancellation_ratio || 0);
          const cls = dr >= 70 ? "good" : dr >= 40 ? "warn" : "bad";

          const band = data.volume_band
            ? `<span class="band">${esc(data.volume_band)}</span>`
            : "";
          const range = data.volume_range
            ? `<span class="range">${esc(data.volume_range)}</span>`
            : "";
          const reports =
            typeof data.fraud_reports === "number"
              ? `<div><span>Fraud Reports</span><strong>${esc(data.fraud_reports)}</strong></div>`
              : "";

          return `
          <div class="card ${cls}">
            <div class="card-header">
              <span class="name">${esc(name)}</span>
              <span class="badge ${cls}">${esc(dr)}%</span>
              ${refreshBtn}
            </div>
            <div class="stats">
              <div><span>Delivery Ratio</span><strong>${esc(dr)}%</strong></div>
              <div><span>Cancellation Ratio</span><strong>${esc(cr)}%</strong></div>
              ${reports}
            </div>
            ${band || range ? `<div class="meta">${band}${range}</div>` : ""}
            <div class="bar"><div class="fill ${cls}" style="width:${Math.max(0, Math.min(100, dr))}%"></div></div>
          </div>`;
        }

        if (shape === "pathao") {
          const rating = data.data?.customer_rating || "unknown";
          const riskLevel = data.data?.risk_level;
          const successRate = data.data?.success_rate;

          const mapped = PATHAO_RATING_MAP[rating];
          const cls = mapped?.cls || PATHAO_RISK_MAP[riskLevel] || "";
          const label = mapped?.label || rating.replace(/_/g, " ");

          const cells = [];
          cells.push(
            `<div><span>Customer Rating</span><strong>${esc(rating)}</strong></div>`,
          );
          if (typeof riskLevel === "string") {
            cells.push(
              `<div><span>Risk Level</span><strong>${esc(riskLevel)}</strong></div>`,
            );
          }
          if (typeof successRate === "number") {
            cells.push(
              `<div><span>Est. Success Rate</span><strong>${esc(successRate)}%</strong></div>`,
            );
          }

          const showCount =
            data.data?.show_count === false
              ? `<p class="msg">Pathao has hidden delivery counts for this number.</p>`
              : "";

          return `
          <div class="card ${cls}">
            <div class="card-header">
              <span class="name">${esc(name)}</span>
              <span class="badge ${cls}">${esc(label)}</span>
              ${refreshBtn}
            </div>
            <div class="stats stats-${cells.length}">
              ${cells.join("")}
            </div>
            ${showCount}
          </div>`;
        }

        if (shape === "carrybee") {
          const ratio = Number(data.success_ratio || 0);
          const fraud = Number(data.fraud_count || 0);
          const hasFraud = fraud > 0;
          const cls = hasFraud
            ? "bad"
            : ratio >= 70
              ? "good"
              : ratio >= 40
                ? "warn"
                : "bad";

          const fraudChip = hasFraud
            ? `<div class="fraud-alert">
                 <span class="fraud-icon">⚠</span>
                 <span><strong>${esc(fraud)}</strong> fraud report${fraud === 1 ? "" : "s"} on record</span>
               </div>`
            : `<div class="fraud-clear">
                 <span class="fraud-icon">✓</span>
                 <span>No fraud reports on record</span>
               </div>`;

          const nameChip = data.customer_name
            ? `<p class="customer-name">${esc(data.customer_name)}</p>`
            : "";

          return `
          <div class="card ${cls}">
            <div class="card-header">
              <span class="name">${esc(name)}</span>
              <span class="badge ${cls}">${esc(ratio)}%</span>
              ${refreshBtn}
            </div>
            ${nameChip}
            <div class="stats stats-4">
              <div><span>Success</span><strong>${esc(data.success ?? 0)}</strong></div>
              <div><span>Cancel</span><strong>${esc(data.cancel ?? 0)}</strong></div>
              <div><span>Total</span><strong>${esc(data.total ?? 0)}</strong></div>
              <div class="stat-fraud">
                <span>Fraud Count</span>
                <strong class="${hasFraud ? "fraud-value" : ""}">${esc(fraud)}</strong>
              </div>
            </div>
            <div class="bar"><div class="fill ${cls}" style="width:${Math.max(0, Math.min(100, ratio))}%"></div></div>
            ${fraudChip}
          </div>`;
        }

        if (shape === "classic") {
          const ratio = Number(data.success_ratio || 0);
          const cls = ratio >= 70 ? "good" : ratio >= 40 ? "warn" : "bad";

          return `
          <div class="card ${cls}">
            <div class="card-header">
              <span class="name">${esc(name)}</span>
              <span class="badge ${cls}">${esc(ratio)}%</span>
              ${refreshBtn}
            </div>
            <div class="stats">
              <div><span>Success</span><strong>${esc(data.success ?? 0)}</strong></div>
              <div><span>Cancel</span><strong>${esc(data.cancel ?? 0)}</strong></div>
              <div><span>Total</span><strong>${esc(data.total ?? 0)}</strong></div>
            </div>
            <div class="bar"><div class="fill ${cls}" style="width:${Math.max(0, Math.min(100, ratio))}%"></div></div>
          </div>`;
        }

        return `
        <div class="card">
          <div class="card-header">
            <span class="name">${esc(name)}</span>
            <span class="badge">Raw</span>
            ${refreshBtn}
          </div>
          <pre class="raw">${esc(JSON.stringify(data, null, 2))}</pre>
        </div>`;
      }

      // ── Aggregation rule (shown in the info tooltip) ─────────────────────
      function renderAggregateRule() {
        return `
          <div class="rule">
            <h4>The 60 / 40 aggregation rule</h4>
            <p>
              The aggregate blends two groups of couriers to produce a single
              success ratio. Each group's ratio is weighted and combined —
              real counts, ratio buckets, and Pathao's rating signal all fold
              into the same currency.
            </p>

            <table class="rule-table">
              <thead>
                <tr>
                  <th>Group</th>
                  <th>Couriers</th>
                  <th>Weight</th>
                  <th>Source of numbers</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>A</strong></td>
                  <td>Steadfast, Pathao</td>
                  <td>60%</td>
                  <td>
                    Steadfast: delivery_ratio applied to the volume bucket.
                    Pathao: success_rate mapped onto a virtual 10-order profile.
                  </td>
                </tr>
                <tr>
                  <td><strong>B</strong></td>
                  <td>RedX, Paperfly, Carrybee</td>
                  <td>40%</td>
                  <td>Native delivered / cancelled counts.</td>
                </tr>
              </tbody>
            </table>

            <h4>Per-courier confidence inside a group</h4>
            <ul>
              <li><strong>Steadfast</strong> — 0.9 when a volume bucket is present, else 0.5</li>
              <li><strong>Pathao</strong> — 0.7 (low risk) · 0.6 (medium) · 0.5 (high) · 0.4 (very high) · 0.3 (unknown)</li>
              <li><strong>Paperfly / Carrybee / RedX</strong> — 1.0 when real counts are returned, else 0.4</li>
            </ul>

            <h4>Edge case</h4>
            <p>
              If only one group has usable data, that group's ratio is used at
              100% — never scaled down to 60% or 40%. This keeps the aggregate
              honest for customers who only have history on one side.
            </p>
          </div>
        `;
      }

      // ── Full result renderer ──────────────────────────────────────────────
      function renderResults(data) {
        CURRENT_DATA = data;
        const agg = data.aggregate || {};
        const aggRatio = Number(agg.success_ratio || 0);
        const aggCls =
          aggRatio >= 70 ? "good" : aggRatio >= 40 ? "warn" : "bad";

        const cards = AVAILABLE_COURIERS.map((c) =>
          renderCourierCard(c, data[c]),
        ).join("");

        // Group ratio lines — only shown when at least one is not null
        const groupLines = [];
        if (agg.group_a_ratio !== null && agg.group_a_ratio !== undefined) {
          groupLines.push(
            `<div class="group-line">
               <span class="group-tag group-tag-a">A</span>
               <span class="group-label">Steadfast + Pathao (60%)</span>
               <strong class="group-ratio">${esc(agg.group_a_ratio)}%</strong>
             </div>`,
          );
        }
        if (agg.group_b_ratio !== null && agg.group_b_ratio !== undefined) {
          groupLines.push(
            `<div class="group-line">
               <span class="group-tag group-tag-b">B</span>
               <span class="group-label">RedX + Paperfly + Carrybee (40%)</span>
               <strong class="group-ratio">${esc(agg.group_b_ratio)}%</strong>
             </div>`,
          );
        }

        const groupBlock = groupLines.length
          ? `<div class="group-breakdown">
               <span class="group-breakdown-label">Group breakdown</span>
               ${groupLines.join("")}
             </div>`
          : "";

        resultsEl.innerHTML = `
          <div class="aggregate ${aggCls}">
            <div class="agg-head">
              <h2>Aggregate</h2>
              <span class="info" tabindex="0" aria-label="How the aggregate is calculated">
                ⓘ
                <span class="info-tip">${renderAggregateRule()}</span>
              </span>
            </div>

            <div class="agg-stats">
              <div><span>Total Success</span><strong>${esc(agg.total_success ?? 0)}</strong></div>
              <div><span>Total Cancel</span><strong>${esc(agg.total_cancel ?? 0)}</strong></div>
              <div><span>Total Deliveries</span><strong>${esc(agg.total_deliveries ?? 0)}</strong></div>
              <div><span>Success Ratio</span><strong>${esc(aggRatio)}%</strong></div>
              <div><span>Cancel Ratio</span><strong>${esc(agg.cancel_ratio ?? 0)}%</strong></div>
            </div>

            ${groupBlock}

            <p class="agg-note">
              Weighted blend of all courier signals. Hover the ⓘ icon
              for the full rule.
            </p>
          </div>
          <div class="grid">${cards}</div>
        `;
        resultsEl.classList.remove("hidden");

        // Bind refresh buttons
        resultsEl.querySelectorAll(".card-refresh").forEach((btn) => {
          btn.addEventListener("click", () =>
            refreshSingleCourier(btn.dataset.courier, btn),
          );
        });
      }

      // ── Individual courier refresh ────────────────────────────────────────
      async function refreshSingleCourier(courier, btn) {
        if (!CURRENT_PHONE || !CURRENT_DATA) return;
        btn.disabled = true;
        btn.classList.add("spinning");

        try {
          const resp = await fetch(
            `/api/check/${encodeURIComponent(courier)}/${encodeURIComponent(CURRENT_PHONE)}`,
          );
          const json = await resp.json();

          if (!json.success || !json.data) {
            btn.classList.remove("spinning");
            btn.disabled = false;
            return;
          }

          CURRENT_DATA[courier] = json.data;

          const card = btn.closest(".card");
          const wrapper = document.createElement("div");
          wrapper.innerHTML = renderCourierCard(courier, json.data).trim();
          const newCard = wrapper.firstElementChild;
          card.replaceWith(newCard);

          newCard
            .querySelector(".card-refresh")
            .addEventListener("click", (e) =>
              refreshSingleCourier(courier, e.currentTarget),
            );
        } catch (err) {
          console.error("Refresh failed:", err);
          btn.classList.remove("spinning");
          btn.disabled = false;
        }
      }

      // ── Load courier list on startup ──────────────────────────────────────
      async function loadCouriers() {
        try {
          const resp = await fetch("/api/couriers");
          const json = await resp.json();

          if (!json.success || !Array.isArray(json.couriers)) {
            throw new Error("Invalid response");
          }

          const configured = json.couriers.filter((c) => c.configured);
          const disabled = json.couriers.filter((c) => !c.configured);

          AVAILABLE_COURIERS = configured.map((c) => c.name);

          const activeChips = configured
            .map((c) => `<span class="chip chip-on">${esc(c.name)}</span>`)
            .join("");
          const disabledChips = disabled
            .map((c) => `<span class="chip chip-off">${esc(c.name)}</span>`)
            .join("");

          couriersStatusEl.innerHTML = `
            <span class="couriers-status-label">Active:</span>
            ${activeChips}
            ${disabled.length ? `<span class="couriers-status-label">Disabled:</span>${disabledChips}` : ""}
          `;
        } catch (err) {
          console.error("Could not load courier list:", err);
          AVAILABLE_COURIERS = [
            "steadfast",
            "pathao",
            "redx",
            "paperfly",
            "carrybee",
          ];
        }
      }

      // ── Main form submit ──────────────────────────────────────────────────
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const phone = phoneInput.value.trim();

        if (!/^01[3-9][0-9]{8}$/.test(phone)) {
          show(
            statusEl,
            `<div class="alert error">Please enter a valid 11-digit number.</div>`,
          );
          hide(resultsEl);
          return;
        }

        CURRENT_PHONE = phone;
        setLoading(true);
        show(statusEl, `<div class="alert info">Checking ${esc(phone)}…</div>`);
        hide(resultsEl);

        try {
          const resp = await fetch(`/api/check/${encodeURIComponent(phone)}`);
          const json = await resp.json();

          if (!resp.ok || !json.success) {
            show(
              statusEl,
              `<div class="alert error">${esc(json.error || "Request failed")}</div>`,
            );
            return;
          }

          renderResults(json.data);
          hide(statusEl);
        } catch (err) {
          show(
            statusEl,
            `<div class="alert error">Network error: ${esc(err.message)}</div>`,
          );
        } finally {
          setLoading(false);
        }
      });

      // ── Boot ──────────────────────────────────────────────────────────────
      loadCouriers();
    </script>
  </body>
</html>
